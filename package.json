    "@angular/elements": "^15.2.6",
    "@angular/forms": "^14.0.0",
    "@angular/platform-browser": "^14.0.0",
    "@angular/platform-browser-dynamic": "^14.0.0",
    "@angular/router": "^14.0.0",
    "module-federation-plugin": "^0.8.4",
    "react-redux": "^8.0.5",
    "redux": "^4.2.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "web-vitals": "^5.2.0",
    "zone.js": "~0.11.4"
