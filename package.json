    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@types/jasmine": "~4.0.0",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "audit-ci": "^7.1.0",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "jasmine-core": "~4.1.0",
    "karma": "~6.3.0",
